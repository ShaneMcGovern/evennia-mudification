# Cherry-picked from github/gitignore's Python.gitignore, not vendored wholesale.
__pycache__/
*.py[codz]
*$py.class
*.so

build/
dist/
sdist/
wheels/
*.egg-info/
.eggs/
*.egg
MANIFEST

# uv.lock is committed deliberately (reproducible installs); .env stays local
# (git identity, later secrets). .env.example is the committed copy to copy.
.venv/
venv/
.env
.envrc

# badges/coverage.svg is committed; coverage.xml is its regenerable input.
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache
.hypothesis/

.mypy_cache/
.dmypy.json
.ruff_cache/
.pyre/
.pytype/

.ipynb_checkpoints/

*.log

.DS_Store
Thumbs.db
