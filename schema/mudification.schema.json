            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desc"
        },
        "kind": {
          "const": "prototype",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": ["id", "key", "kind"],
      "title": "PrototypeEntity",
      "type": "object"
    },
    "ReverseOverride": {
      "additionalProperties": false,
