{
  "$defs": {
    "ExitEntity": {
      "additionalProperties": false,
      "description": "An exit between two rooms.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "typeclass": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Typeclass"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "attrs": {
          "additionalProperties": true,
          "title": "Attrs",
          "type": "object"
        },
        "tags": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tags",
          "type": "object"
        },
        "locks": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Locks",
          "type": "object"
        },
        "permissions": {
          "items": {
            "type": "string"
          },
          "title": "Permissions",
          "type": "array"
        },
        "desc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desc"
        },
        "kind": {
          "const": "exit",
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "pattern": "^@[a-z0-9][a-z0-9_-]*$",
          "title": "Location",
          "type": "string"
        },
        "destination": {
          "pattern": "^@[a-z0-9][a-z0-9_-]*$",
          "title": "Destination",
          "type": "string"
        },
        "reverse": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ReverseOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reverse"
        }
      },
      "required": ["id", "key", "kind", "location", "destination"],
      "title": "ExitEntity",
      "type": "object"
    },
    "ObjectEntity": {
      "additionalProperties": false,
      "description": "A plain object; `location` may be a room or another object.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "key": {
          "title": "Key",
