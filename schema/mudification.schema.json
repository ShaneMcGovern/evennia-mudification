          "type": "array"
        },
        "desc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desc"
        },
        "kind": {
          "const": "object",
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "pattern": "^@[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "home": {
          "anyOf": [
            {
              "pattern": "^@[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Home"
        },
        "count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "prototype": {
          "anyOf": [
            {
              "pattern": "^@[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prototype"
        },
        "contents": {
          "items": {
            "discriminator": {
              "mapping": {
                "exit": "#/$defs/ExitEntity",
                "object": "#/$defs/ObjectEntity",
                "prototype": "#/$defs/PrototypeEntity",
                "room": "#/$defs/RoomEntity"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RoomEntity"
              },
              {
                "$ref": "#/$defs/ExitEntity"
              },
              {
                "$ref": "#/$defs/ObjectEntity"
              },
              {
                "$ref": "#/$defs/PrototypeEntity"
              }
            ]
          },
          "title": "Contents",
          "type": "array"
        }
      },
      "required": ["id", "key", "kind"],
      "title": "ObjectEntity",
      "type": "object"
    },
    "PrototypeEntity": {
      "additionalProperties": false,
      "description": "A reusable template other entities reference with ``prototype``.",
