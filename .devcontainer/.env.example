# Copy to .env and put your own identity in it:
#
#   cp .devcontainer/.env.example .devcontainer/.env
#
# Generation already wrote a .devcontainer/.env from the answers given, so the
# owner of this repository does not need to do anything. This file is the
# committed copy, for anyone else who clones it. .env itself is gitignored.
#
# Neither value may be empty: git reads them directly and they outrank
# user.name, so a blank one fails every commit with "fatal: empty ident name".
GIT_AUTHOR_NAME="Your Name"
GIT_AUTHOR_EMAIL="you@example.com"

# Linux hosts only, and only if your account is not uid 1000. A bind mount
# passes ownership through unchanged, so a mismatch leaves the container unable
# to write into /app and pytest fails on coverage.xml. Uncomment, set these to
# your own `id -u` and `id -g`, and rebuild:
#
#   docker compose -f .devcontainer/compose.yaml up -d --build
#
# Windows and macOS map every file to the container user, so leave these alone.
# USER_UID=1000
# USER_GID=1000
